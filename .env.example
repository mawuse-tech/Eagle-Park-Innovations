# Server only: reuse the existing Atlas URI and JWT secret.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER/
JWT_SECRET=replace-with-your-existing-server-secret
JWT_EXPIRES_IN=7d
# Server only: signed article image uploads to Cloudinary.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Existing browser-visible payment configuration (not a secret).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key
